<?xml version="1.0" encoding="utf-8"?>
<!--
  Better Smithing Continued mod settings.

  UnlimitedCraftingStamina: When true (default), refining, smelting, and smithing
    cost zero stamina, so heroes can craft as long as materials are available.

  StaminaRecoveryMultiplierInTowns: Multiplier applied to the hourly smithing
    stamina increase while the hero's party is inside a settlement.
    1.0 = vanilla. Default 5.0. Must be >= 0.

  StaminaRecoveryMultiplierOutsideTowns: Multiplier applied to the hourly
    smithing stamina increase while the hero's party is in the wilderness.
    1.0 = vanilla. Default 5.0. Must be >= 0.

  AddWeaponTierPrefixes: When true (default), player-crafted weapons that have
    a quality modifier are renamed in inventory to include their tier word
    (Rusty / Dull / Balanced / Masterwork / Legendary), the same way pre-tiered
    loot weapons display.

  UseOwnPrefixesOnly: When true, this mod's own English prefix words are used
    even if the game itself supplied a modifier name. When false (default),
    the game's modifier name is preferred and this mod's prefix is only used
    as a fallback. Has no effect when AddWeaponTierPrefixes is false.

  BatchOperationsEnabled: When true (default), holding Shift, Ctrl, or
    Ctrl+Shift while clicking Refine / Smelt / Forge in the smithy repeats
    the action up to the configured count. The loop stops automatically when
    materials are gone (refine/smelt) or stamina runs out (when
    UnlimitedCraftingStamina is false).

  ShiftMultiplier:       Total ops to perform when Shift is held. Default 5.
  CtrlMultiplier:        Total ops to perform when Ctrl is held. Default 10.
  CtrlShiftMultiplier:   Total ops to perform when Ctrl+Shift is held.
                         Default 0 = "as many as possible" (capped at 1000
                         iterations as a safety ceiling).
-->
<BetterSmithingContinuedSettings>
  <UnlimitedCraftingStamina>true</UnlimitedCraftingStamina>
  <StaminaRecoveryMultiplierInTowns>5.0</StaminaRecoveryMultiplierInTowns>
  <StaminaRecoveryMultiplierOutsideTowns>5.0</StaminaRecoveryMultiplierOutsideTowns>
  <AddWeaponTierPrefixes>true</AddWeaponTierPrefixes>
  <UseOwnPrefixesOnly>false</UseOwnPrefixesOnly>
  <BatchOperationsEnabled>true</BatchOperationsEnabled>
  <ShiftMultiplier>5</ShiftMultiplier>
  <CtrlMultiplier>10</CtrlMultiplier>
  <CtrlShiftMultiplier>0</CtrlShiftMultiplier>
</BetterSmithingContinuedSettings>
